{
  "pre-push-verification": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_push_hook.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
